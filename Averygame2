<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Avery's Star Collector</title>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            user-select: none;
            -webkit-user-select: none;
        }
        body, html {
            width: 100%;
            height: 100%;
            overflow: hidden;
            background-color: #11001c;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        }
        #gameContainer {
            position: relative;
            width: 100%;
            height: 100%;
            max-width: 600px;
            margin: 0 auto;
            background: linear-gradient(to bottom, #11001c, #22003c);
            overflow: hidden;
        }
        canvas {
            display: block;
            width: 100%;
            height: 100%;
        }
        .screen {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            color: white;
            text-align: center;
            padding: 20px;
            z-index: 10;
        }
        h1 {
            font-size: 2.5rem;
            color: #ff007f;
            margin-bottom: 10px;
            text-shadow: 0 0 10px rgba(255, 0, 127, 0.5);
        }
        p {
            font-size: 1.1rem;
            margin-bottom: 30px;
            color: #e0aaff;
        }
        button {
            padding: 15px 40px;
            font-size: 1.3rem;
            font-weight: bold;
            color: white;
            background: linear-gradient(45deg, #ff007f, #7928ca);
            border: none;
            border-radius: 30px;
            cursor: pointer;
            box-shadow: 0 4px 15px rgba(255, 0, 127, 0.4);
            outline: none;
            transform: scale(1);
            transition: transform 0.1s ease;
        }
        button:active {
            transform: scale(0.95);
        }
        #hud {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            padding: 15px 20px;
            display: flex;
            justify-content: space-between;
            color: white;
            font-size: 1.2rem;
            font-weight: bold;
            font-family: monospace;
            z-index: 5;
            pointer-events: none;
        }
        #scoreDisplay { color: #00f5d4; }
        #livesDisplay { color: #ff007f; }
        .hidden { display: none !important; }
    </style>
</head>
<body>

<div id="gameContainer">
    <!-- HUD -->
    <div id="hud" class="hidden">
        <div id="scoreDisplay">SCORE: 0</div>
        <div id="livesDisplay">LIVES: ❤️❤️❤️</div>
    </div>

    <!-- Start Screen -->
    <div id="startScreen" class="screen">
        <h1>Avery's Dash</h1>
        <p>Drag your finger anywhere to move Avery.<br>Collect stars. Avoid the fireballs!</p>
        <button id="startButton">START GAME</button>
    </div>

    <!-- Game Over Screen -->
    <div id="gameOverScreen" class="screen hidden">
        <h1>Game Over</h1>
        <p id="finalScore">Final Score: 0</p>
        <button id="restartButton">PLAY AGAIN</button>
    </div>

    <!-- Game Canvas -->
    <canvas id="gameCanvas"></canvas>
</div>

<script>
    const canvas = document.getElementById('gameCanvas');
    const ctx = canvas.getContext('2d');
    const startScreen = document.getElementById('startScreen');
    const gameOverScreen = document.getElementById('gameOverScreen');
    const hud = document.getElementById('hud');
    const scoreDisplay = document.getElementById('scoreDisplay');
    const livesDisplay = document.getElementById('livesDisplay');
    const startButton = document.getElementById('startButton');
    const restartButton = document.getElementById('restartButton');

    // Game variables
    let gameActive = false;
    let score = 0;
    let lives = 3;
    let stars = [];
    let hazards = [];
    let particles = [];
    let spawnTimer = 0;
    let hazardSpeedMultiplier = 1;

    // Player object (Avery)
    const player = {
        x: 0,
        y: 0,
        radius: 22,
        targetX: 0,
        targetY: 0,
        speed: 0.25 // Smooth movement interpolation factor
    };

    // Initialize/Resize Canvas
    function resizeCanvas() {
        const container = document.getElementById('gameContainer');
        canvas.width = container.clientWidth;
        canvas.height = container.clientHeight;
        if (!gameActive && player.x === 0) {
            player.x = canvas.width / 2;
            player.y = canvas.height * 0.75;
            player.targetX = player.x;
            player.targetY = player.y;
        }
    }
    window.addEventListener('resize', resizeCanvas);
    resizeCanvas();

    // Input Handling (Touch & Mouse)
    function handleMove(clientX, clientY) {
        if (!gameActive) return;
        const rect = canvas.getBoundingClientRect();
        player.targetX = clientX - rect.left;
        player.targetY = clientY - rect.top;
        
        // Keep target within boundaries
        if (player.targetX < player.radius) player.targetX = player.radius;
        if (player.targetX > canvas.width - player.radius) player.targetX = canvas.width - player.radius;
        if (player.targetY < player.radius) player.targetY = player.radius;
        if (player.targetY > canvas.height - player.radius) player.targetY = canvas.height - player.radius;
    }

    window.addEventListener('touchmove', (e) => {
        if(e.touches.length > 0) {
            handleMove(e.touches[0].clientX, e.touches[0].clientY);
            if(gameActive) e.preventDefault();
        }
    }, { passive: false });

    window.addEventListener('touchstart', (e) => {
        if(e.touches.length > 0 && gameActive) {
            handleMove(e.touches[0].clientX, e.touches[0].clientY);
        }
    }, { passive: true });

    window.addEventListener('mousemove', (e) => {
        handleMove(e.clientX, e.clientY);
    });

    // Start Game Function
    function startGame() {
        score = 0;
        lives = 3;
        stars = [];
        hazards = [];
        particles = [];
        hazardSpeedMultiplier = 1;
        spawnTimer = 0;
        
        player.x = canvas.width / 2;
        player.y = canvas.height * 0.75;
        player.targetX = player.x;
        player.targetY = player.y;

        updateHUD();
        
        startScreen.classList.add('hidden');
        gameOverScreen.classList.add('hidden');
        hud.classList.remove('hidden');
        
        gameActive = true;
    }

    function gameOver() {
        gameActive = false;
        hud.classList.add('hidden');
        document.getElementById('finalScore').innerText = `Final Score: ${score}`;
        gameOverScreen.classList.remove('hidden');
    }

    function updateHUD() {
        scoreDisplay.innerText = `SCORE: ${score}`;
        livesDisplay.innerText = `LIVES: ` + '❤️'.repeat(Math.max(0, lives));
    }

    function spawnParticle(x, y, color) {
        for(let i=0; i<8; i++) {
            particles.push({
                x: x,
                y: y,
                vx: (Math.random() - 0.5) * 6,
                vy: (Math.random() - 0.5) * 6,
                radius: Math.random() * 3 + 2,
                alpha: 1,
                color: color
            });
        }
    }

    // Main Game Loop
    function update(timestamp) {
        ctx.clearRect(0, 0, canvas.width, canvas.height);

        if (gameActive) {
            // Smoothly move player toward target position
            player.x += (player.targetX - player.x) * player.speed;
            player.y += (player.targetY - player.y) * player.speed;

            // Spawning Logic
            spawnTimer++;
            if (spawnTimer % 45 === 0) { // Spawn star
                stars.push({
                    x: Math.random() * (canvas.width - 40) + 20,
                    y: -20,
                    radius: 12,
                    speed: Math.random() * 2 + 2
                });
            }
            if (spawnTimer % 60 === 0) { // Spawn hazard
                hazards.push({
                    x: Math.random() * (canvas.width - 40) + 20,
                    y: -20,
                    radius: 15,
                    speed: (Math.random() * 3 + 3) * hazardSpeedMultiplier
                });
            }

            // Difficulty progression
            hazardSpeedMultiplier = 1 + (score * 0.05);

            // Update & Draw Stars
            for (let i = stars.length - 1; i >= 0; i--) {
                let s = stars[i];
                s.y += s.speed;

                // Collision Check (Avery collects star)
                let dist = Math.hypot(player.x - s.x, player.y - s.y);
                if (dist < player.radius + s.radius) {
                    score += 1;
                    updateHUD();
                    spawnParticle(s.x, s.y, '#00f5d4');
                    stars.splice(i, 1);
                    continue;
                }

                // Remove off-screen items
                if (s.y > canvas.height + 20) {
                    stars.splice(i, 1);
                    continue;
                }

                // Draw Star shape
                ctx.fillStyle = '#00f5d4';
                ctx.beginPath();
                ctx.arc(s.x, s.y, s.radius, 0, Math.PI * 2);
                ctx.fill();
                // Inner glow
                ctx.fillStyle = '#ffffff';
                ctx.beginPath();
                ctx.arc(s.x, s.y, s.radius * 0.5, 0, Math.PI * 2);
                ctx.fill();
            }

            // Update & Draw Hazards
            for (let i = hazards.length - 1; i >= 0; i--) {
                let h = hazards[i];
                h.y += h.speed;

                // Collision Check (Avery hits fire ball)
                let dist = Math.hypot(player.x - h.x, player.y - h.y);
                if (dist < player.radius + h.radius) {
                    lives -= 1;
                    updateHUD();
                    spawnParticle(h.x, h.y, '#ff007f');
                    hazards.splice(i, 1);
                    
                    if (lives <= 0) {
                        gameOver();
                    }
                    continue;
                }

                if (h.y > canvas.height + 20) {
                    hazards.splice(i, 1);
                    continue;
                }

                // Draw Hazard
                ctx.fillStyle = '#ff007f';
                ctx.beginPath();
                ctx.arc(h.x, h.y, h.radius, 0, Math.PI * 2);
                ctx.fill();
            }
        }

        // Update & Draw Particles
        for (let i = particles.length - 1; i >= 0; i--) {
            let p = particles[i];
            p.x += p.vx;
            p.y += p.vy;
            p.alpha -= 0.02;
            if (p.alpha <= 0) {
                particles.splice(i, 1);
                continue;
            }
            ctx.save();
            ctx.globalAlpha = p.alpha;
            ctx.fillStyle = p.color;
            ctx.beginPath();
            ctx.arc(p.x, p.y, p.radius, 0, Math.PI * 2);
            ctx.fill();
            ctx.restore();
        }

        // Draw Player (Avery)
        ctx.save();
        ctx.shadowBlur = 15;
        ctx.shadowColor = '#9b5de5';
        ctx.fillStyle = '#9b5de5';
        ctx.beginPath();
        ctx.arc(player.x, player.y, player.radius, 0, Math.PI * 2);
        ctx.fill();
        ctx.restore();

        // Draw Avery's Hair/Cap detailing to make it unique
        ctx.fillStyle = '#f15bb5';
        ctx.beginPath();
        ctx.arc(player.x, player.y - 5, player.radius * 0.7, Math.PI, 0);
        ctx.fill();

        // Draw Avery's Eyes
        ctx.fillStyle = '#ffffff';
        ctx.beginPath();
        ctx.arc(player.x - 7, player.y, 4, 0, Math.PI * 2);
        ctx.arc(player.x + 7, player.y, 4, 0, Math.PI * 2);
        ctx.fill();
        ctx.fillStyle = '#000000';
        ctx.beginPath();
        ctx.arc(player.x - 7, player.y, 1.5, 0, Math.PI * 2);
        ctx.arc(player.x + 7, player.y, 1.5, 0, Math.PI * 2);
        ctx.fill();

        requestAnimationFrame(update);
    }

    // Button event listeners
    startButton.addEventListener('click', startGame);
    restartButton.addEventListener('click', startGame);

    // Start rendering loop immediately
    requestAnimationFrame(update);
</script>
</body>
</html>
